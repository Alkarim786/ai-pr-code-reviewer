# Anthropic API (required for LLM agents; omit and use --static-only otherwise)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# GitHub (fine-grained token with Pull requests: read/write, Contents: read)
GITHUB_TOKEN=
# Webhook mode
GITHUB_WEBHOOK_SECRET=
# Limits
MAX_COMMENTS=20
MAX_TOKENS_PER_PR=400000
